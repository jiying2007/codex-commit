{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": [
      "ES2022"
    ],
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "src/safe-contract.js",
    "src/commit-style.js",
    "src/scope-intelligence.js",
    "src/policy-validation.js",
    "src/process-runner.js"
  ]
}
